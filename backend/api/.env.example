# Pooled Neon URL (host contains -pooler). Used by the API at runtime.
DATABASE_URL=
# Direct Neon URL (no -pooler). Used only by backend/db migrate and seed.
DATABASE_URL_UNPOOLED=
# Long random string, salts the hashed IP used for bulk-request rate limiting.
RATE_LIMIT_SALT=
# Vercel sends this as a Bearer token to the cron route.
CRON_SECRET=
# Optional: the PWA origin, e.g. https://dumpguard.vercel.app. Enables cross-origin POST for bulk-request.
ALLOWED_ORIGIN=

# Web push reminders: node scripts/vapid.mjs prints the key pair; subject is a mailto: you control
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
